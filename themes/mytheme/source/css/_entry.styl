// ============================================================
// 首页 / 列表页的文章卡片
// ============================================================

.entry-list
  display: flex
  flex-direction: column
  gap: $gap

.entry
  // 作为右下角凸出按钮的定位基准
  position: relative
  padding: 14px 16px

  &:hover
    border-color: rgba(160, 200, 235, 0.95)

// ---------- 标题 + 日期 ----------
.entry-head
  margin-bottom: 8px
  border-bottom: 1px solid rgba(120, 170, 215, 0.28)
  padding-bottom: 7px

.entry-title
  margin: 0 0 3px
  font-size: 1.18em
  font-weight: $font-weight-bold

  a
    color: $c-text

    &:hover
      color: $c-accent-deep
      text-decoration: none

.entry-date
  display: block
  color: $c-text-mute
  font-size: 0.82em

// 带右下角按钮的卡片，底部留出按钮凸出的空间
.entry.has-read-more
  padding-bottom: 26px

// ---------- 内层小窗口：正文摘要 ----------
// 用 .panel-inset 统一表示"面板里再套一层更不透的窗口"
.panel-inset
  padding: 10px 12px
  border: 1px solid rgba(120, 170, 215, 0.55)
  border-radius: $radius-sm
  background: $glass-tint-inset
  // 内凹阴影，做出"陷进去"的窗口感
  box-shadow: inset 0 1px 3px rgba(30, 65, 100, 0.18)

.entry-body
  overflow: hidden

.entry-thumb
  float: left
  display: block
  width: 130px
  margin: 0 14px 6px 0
  padding: 3px
  border: 1px solid $glass-edge
  border-radius: $radius-sm
  background: rgba(255, 255, 255, 0.8)

  img
    display: block
    width: 100%
    border-radius: 2px

.entry-excerpt
  margin: 0
  color: $c-text
  font-size: 0.94em

// ---------- 右下角凸出的 Read More... ----------
.read-more
  position: absolute
  right: 10px
  bottom: -12px
  display: inline-block
  padding: 3px 16px
  border: $panel-border-width solid $panel-border
  border-radius: $radius
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(214, 234, 250, 0.94) 100%)
  // 凸出部分要有投影才像浮在卡片上
  box-shadow: 0 3px 7px rgba(20, 45, 70, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.98)
  color: $c-text-soft
  font-size: 0.85em
  white-space: nowrap

  &:hover
    border-color: $c-accent
    background: linear-gradient(180deg, #ffffff 0%, rgba(190, 222, 249, 0.98) 100%)
    color: $c-accent-deep
    text-decoration: none

@media (max-width: 600px)
  .entry-thumb
    float: none
    width: 100%
    margin: 0 0 8px
