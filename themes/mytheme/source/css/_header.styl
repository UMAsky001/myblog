// ============================================================
// 顶部导航栏
// ============================================================

.site-header
  position: sticky
  top: 0
  z-index: 20
  border-bottom: $panel-border-width solid $panel-border
  background: $glass-tint
  box-shadow: 0 1px 3px rgba(50, 95, 135, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.95)
  backdrop-filter: $glass-blur
  -webkit-backdrop-filter: $glass-blur

.header-inner
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 12px
  padding-top: 10px
  padding-bottom: 10px

// ---------- 站点标题 ----------
.brand
  display: flex
  align-items: center
  gap: 8px
  margin-right: auto

.brand-mark
  width: 14px
  height: 14px
  border: 1px solid rgba(255, 255, 255, 0.9)
  border-radius: 50%
  background: radial-gradient(circle at 32% 28%, #ffffff 0%, #a8d4f5 42%, $c-accent 100%)
  box-shadow: 0 1px 3px rgba(40, 90, 135, 0.35)

// ---------- 站名位置：实时时间 ----------
// 现在这里显示时间，同时它本身就是回首页的链接
.brand-clock
  display: inline-block
  padding: 3px 12px
  border: 1px solid $glass-edge
  border-radius: $radius
  background: $glass-tint-inset
  box-shadow: inset 0 1px 2px rgba(30, 65, 100, 0.14)
  // 字号比原来的站名略小一点，避免太抢眼
  font-family: $font-mono
  font-size: 0.98em
  font-weight: $font-weight-bold
  letter-spacing: 0.02em
  color: $c-accent-deep
  white-space: nowrap

  &:hover
    border-color: $c-accent
    color: $c-accent
    text-decoration: none

// 关掉时间开关时，退回显示站名
.brand-title
  font-size: 1.15em
  font-weight: $font-weight-bold
  color: $c-text

  &:hover
    color: $c-accent-deep
    text-decoration: none

// ---------- 菜单：Aero 玻璃按钮 ----------
.site-nav
  display: flex
  flex-wrap: wrap
  gap: 6px

.nav-link
  display: inline-block
  padding: 4px 14px
  border: 1px solid $glass-edge
  border-radius: $radius
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(225, 240, 253, 0.7) 100%)
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95), 0 1px 2px rgba(50, 95, 135, 0.12)
  color: $c-text-soft
  font-size: 0.9em

  &:hover
    border-color: $c-accent
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(198, 226, 250, 0.85) 100%)
    color: $c-accent-deep
    text-decoration: none

.header-slogan
  flex-basis: 100%
  margin: 0
  color: $c-text-mute
  font-size: 0.85em
  text-align: right

@media (max-width: 600px)
  .header-inner
    gap: 8px

  .brand
    margin-right: 0

  .header-slogan
    text-align: left

  .nav-link
    padding: 3px 10px
    font-size: 0.85em
