// ============================================================
// 文章 / 独立页面
// ============================================================

.post,
.page
  display: flex
  flex-direction: column
  gap: $gap

.post-header,
.page-header
  padding: 14px 16px

.post-title,
.page-header .page-title
  margin: 0 0 6px
  font-size: 1.5em

.post-meta
  display: flex
  flex-wrap: wrap
  gap: 6px 14px
  color: $c-text-soft
  font-size: 0.85em

.post-date
  white-space: nowrap

.post-categories
  a
    color: $c-accent-deep

.post-content
  padding: 18px 20px
  overflow-wrap: break-word

  > :first-child
    margin-top: 0

  > :last-child
    margin-bottom: 0

// ---------- 文末标签 ----------
.post-footer
  padding: 10px 16px

.tag-chip
  display: inline-block
  margin: 0 4px 4px 0
  padding: 2px 10px
  border: 1px solid $glass-edge
  border-radius: 10px
  background: rgba(255, 255, 255, 0.7)
  font-size: 0.85em

  &:hover
    border-color: $c-accent
    text-decoration: none

.post-tags
  display: inline

// ---------- 上一篇 / 下一篇 ----------
.post-nav
  display: flex
  gap: $gap

.post-nav-link
  flex: 1 1 0
  display: flex
  flex-direction: column
  gap: 2px
  padding: 10px 14px
  border: 1px solid $glass-border
  border-radius: $radius
  background: $glass-bg-soft
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85)

  &:hover
    border-color: $c-accent
    text-decoration: none

.post-nav-next
  text-align: right

.post-nav-label
  color: $c-text-mute
  font-size: 0.8em

.post-nav-title
  color: $c-text
  font-size: 0.92em

// ---------- 分类 / 标签页标题 ----------
.page-title
  margin: 0 0 $gap
  padding: 12px 16px
  font-size: 1.25em

.page-title-kind
  margin-right: 8px
  color: $c-text-mute
  font-size: 0.85em
  font-weight: 400

@media (max-width: 600px)
  .post-content
    padding: 14px

  .post-nav
    flex-direction: column
