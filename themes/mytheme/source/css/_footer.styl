// ============================================================
// 页脚
// ============================================================

.site-footer
  flex: 0 0 auto
  margin-top: auto
  border-top: $panel-border-width solid $panel-border
  background: $glass-tint
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9)
  backdrop-filter: $glass-blur
  -webkit-backdrop-filter: $glass-blur

.footer-inner
  padding-top: 14px
  padding-bottom: 16px
  color: $c-text-mute
  font-size: 0.84em

.footer-copyright
  margin: 0 0 3px
  color: $c-text-soft

.footer-meta
  margin: 0

  strong
    color: $c-accent-deep
    font-weight: $font-weight-bold
